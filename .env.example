ADVOGADA_FIND_DB=/var/lib/advogada-find/advogada-find.db
CITIES_FILE=config/cities.csv
# BR = todos os municípios do IBGE; config/cities.csv dá prioridade às capitais e polos jurídicos.
CITIES_SCOPE=BR
# Estados pesquisados e contatados primeiro; depois o resto do Brasil.
PRIORITY_STATES=DF,RJ,SP
DRY_RUN=true
TIMEZONE=America/Sao_Paulo
LOOP_SECONDS=300
CITY_RESCAN_DAYS=14
MAX_RESULTS_PER_QUERY=20
MAX_PAGES_PER_SITE=10
HTTP_TIMEOUT_SECONDS=15
CRAWL_DELAY_SECONDS=2
USER_AGENT=advogada-find/0.1 (+candidatura)

BRAVE_SEARCH_API_KEY=

# Volume moderado: poucas mensagens por dia, espaçadas, só em dias úteis.
MAX_EMAILS_PER_DAY=5
MIN_SEND_INTERVAL_SECONDS=1800
MAX_SEND_JITTER_SECONDS=1800
SEND_WINDOW_START=09:00
SEND_WINDOW_END=17:00
SEND_WEEKDAYS=0,1,2,3,4
MAX_SEND_ATTEMPTS=3
SEND_LEASE_SECONDS=600
# false: aceita o endereço geral do escritório (contato@, escritorio@) mesmo sem página "trabalhe conosco".
CONTACT_REQUIRES_CAREERS_SIGNAL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Conta Gmail da própria advogada, com senha de app. Segredo só no arquivo privado.
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
FROM_EMAIL=
FROM_NAME=

APPLICANT_NAME=Ana Carolina Campos
APPLICANT_ROLE=Advogada
APPLICANT_OAB=OAB/DF nº 73.471
APPLICANT_CITY=Brasília/DF
APPLICANT_PHONE=
APPLICANT_EMAIL=
LINKEDIN_URL=https://www.linkedin.com/in/ana-carolina-campos-aabb05192
# Obrigatório no corpo de toda mensagem.
SITE_URL=https://audiencia-df.web.app/
CV_PATH=/opt/advogada-find-private/cv.pdf
CV_FILENAME=Curriculo-Ana-Carolina-Campos.pdf
EMAIL_TEMPLATE=templates/application.txt
EMAIL_SUBJECT=Candidatura | {role} | {oab} | {name}
